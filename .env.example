# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Database (PostgreSQL)
DJANGO_DATABASE_ENGINE=django.db.backends.postgresql
DJANGO_DATABASE_NAME=cts_db
DJANGO_DATABASE_USER=postgres
DJANGO_DATABASE_PASSWORD=change-me
DJANGO_DATABASE_HOST=localhost
DJANGO_DATABASE_PORT=5432

# Redis cache + Celery broker
DJANGO_REDIS_LOCATION=redis://127.0.0.1:6379/1
DJANGO_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DJANGO_CACHE_TTL=3600
# DJANGO_CELERY_TASK_ALWAYS_EAGER=False

# Email (defaults to console backend when unset)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=noreply@example.com
DJANGO_EMAIL_HOST_PASSWORD=change-me
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_ADMIN_NOTIFICATION_EMAIL=admin@example.com

# CORS (only needed when a separate frontend consumes the API)
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
