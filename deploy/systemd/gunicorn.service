[Unit]
Description=CTS CMS Gunicorn daemon
Requires=network.target
After=network.target postgresql.service redis-server.service

[Service]
Type=notify
User=www-data
Group=www-data
RuntimeDirectory=cts
WorkingDirectory=/srv/cts
EnvironmentFile=/srv/cts/.env
Environment=GUNICORN_BIND=unix:/run/cts/gunicorn.sock
ExecStart=/srv/cts/venv/bin/gunicorn bijli.wsgi:application --config deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
